# Pictures change rarely: keep them a week. Font and Firebase files never change (a new version gets a new name).
/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Firebase code: a new version gets a new folder name, so it never changes either.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
